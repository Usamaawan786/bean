{
  "name": "Redemption",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "description": "Customer who redeemed"
    },
    "reward_name": {
      "type": "string",
      "description": "Name of redeemed reward"
    },
    "points_spent": {
      "type": "number",
      "description": "Points used for redemption"
    },
    "redemption_code": {
      "type": "string",
      "description": "Unique code to claim reward"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "claimed",
        "expired",
        "voided"
      ],
      "default": "pending",
      "description": "Redemption status. 'voided' = admin cancelled a fraudulent redemption so it can never be honoured at the counter."
    },
    "void_reason": {
      "type": "string",
      "description": "Reason recorded when the redemption was voided (fraud, system error, etc.)"
    },
    "voided_by": {
      "type": "string",
      "description": "Email of the admin who voided this redemption"
    },
    "voided_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the redemption was voided"
    }
  },
  "required": [
    "customer_email",
    "reward_name",
    "points_spent"
  ],
  "rls": {
    "create": {
      "data.customer_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "user_condition": {
            "role": "cashier"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}