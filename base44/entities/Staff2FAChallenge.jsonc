{
  "name": "Staff2FAChallenge",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the staff member the code was issued to"
    },
    "code_hash": {
      "type": "string",
      "description": "SHA-256 hash of the 6-digit OTP (never store the plaintext code)"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code expires (5 minutes after issue)"
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "Number of failed verification attempts against this challenge"
    },
    "consumed": {
      "type": "boolean",
      "default": false,
      "description": "True once the code was used or invalidated (max attempts / expired)"
    }
  },
  "required": [
    "user_email",
    "code_hash",
    "expires_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}