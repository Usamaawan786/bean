{
  "name": "DeliverySettings",
  "properties": {
    "delivery_radius_km": {
      "default": 4,
      "description": "Maximum delivery distance in km, measured in a straight line from the store",
      "type": "number"
    },
    "estimated_prep_minutes": {
      "default": 15,
      "description": "Estimated preparation time in minutes",
      "type": "number"
    },
    "fee_tiers": {
      "description": "Distance-based fee tiers. If empty, flat_delivery_fee is used.",
      "items": {
        "properties": {
          "fee": {
            "type": "number"
          },
          "max_km": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "flat_delivery_fee": {
      "default": 150,
      "description": "Flat delivery fee in PKR (used when no fee tiers are defined)",
      "type": "number"
    },
    "is_delivery_open": {
      "default": true,
      "description": "Whether delivery is currently accepting orders",
      "type": "boolean"
    },
    "min_order_amount": {
      "default": 0,
      "description": "Minimum order subtotal in PKR required for delivery",
      "type": "number"
    },
    "store_lat": {
      "default": 33.5306669,
      "description": "Bean store latitude (delivery radius center)",
      "type": "number"
    },
    "store_lng": {
      "default": 73.0997785,
      "description": "Bean store longitude (delivery radius center)",
      "type": "number"
    }
  },
  "required": [
    "flat_delivery_fee"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}