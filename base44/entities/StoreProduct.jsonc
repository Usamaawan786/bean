{
  "name": "StoreProduct",
  "properties": {
    "category": {
      "description": "In-store product category",
      "enum": [
        "Breakfast",
        "Omelettes",
        "Sweet",
        "Sandwich & Wraps",
        "All Day Bites",
        "Pastry",
        "Sweeter",
        "Hot Coffee",
        "Cold Coffee",
        "Ice Blended Coffee",
        "Hot Chocolate",
        "Matcha",
        "Add-Ons",
        "Fresher",
        "Smoothies",
        "Teas & More",
        "Other"
      ],
      "type": "string"
    },
    "description": {
      "description": "Product description",
      "type": "string"
    },
    "image_url": {
      "description": "Product image",
      "type": "string"
    },
    "is_available": {
      "default": true,
      "description": "Currently available for sale",
      "type": "boolean"
    },
    "name": {
      "description": "Product name",
      "type": "string"
    },
    "preparation_time": {
      "description": "Estimated prep time in minutes",
      "type": "number"
    },
    "price": {
      "description": "Product price in PKR",
      "type": "number"
    },
    "size_options": {
      "description": "Available sizes (e.g., Small, Medium, Large)",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}