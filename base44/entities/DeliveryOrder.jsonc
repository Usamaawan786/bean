{
  "name": "DeliveryOrder",
  "properties": {
    "accepted_at": {
      "description": "When the order was accepted by admin",
      "format": "date-time",
      "type": "string"
    },
    "customer_email": {
      "description": "Email of the customer who placed the order",
      "type": "string"
    },
    "customer_name": {
      "description": "Customer display name",
      "type": "string"
    },
    "customer_phone": {
      "description": "Customer phone number for delivery contact",
      "type": "string"
    },
    "delivered_at": {
      "description": "When the order was marked delivered / picked up",
      "format": "date-time",
      "type": "string"
    },
    "delivery_address": {
      "description": "Free-text delivery address (for pickup orders: the store)",
      "type": "string"
    },
    "delivery_fee": {
      "description": "Delivery fee charged",
      "type": "number"
    },
    "delivery_lat": {
      "description": "Map pin latitude for delivery address",
      "type": "number"
    },
    "delivery_lng": {
      "description": "Map pin longitude for delivery address",
      "type": "number"
    },
    "delivery_notes": {
      "description": "Optional delivery instructions from customer",
      "type": "string"
    },
    "discount_amount": {
      "description": "App offer discount in PKR",
      "type": "number"
    },
    "discount_percent": {
      "description": "App offer percent applied (0 if none)",
      "type": "number"
    },
    "gst_amount": {
      "description": "GST amount in PKR",
      "type": "number"
    },
    "gst_rate": {
      "description": "GST percent applied to the food subtotal after discount",
      "type": "number"
    },
    "items": {
      "description": "Ordered items",
      "items": {
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "order_number": {
      "description": "Auto-generated delivery order number, e.g. DO-000001",
      "type": "string"
    },
    "order_type": {
      "default": "delivery",
      "description": "delivery or pickup",
      "enum": [
        "delivery",
        "pickup"
      ],
      "type": "string"
    },
    "payment_method": {
      "default": "cash_on_delivery",
      "description": "How the customer will pay at the door / counter. card_on_delivery means a card machine is needed.",
      "enum": [
        "cash_on_delivery",
        "card_on_delivery"
      ],
      "type": "string"
    },
    "pickup_eta_minutes": {
      "description": "Pickup only: minutes from order time the customer expects to arrive",
      "type": "number"
    },
    "pickup_time": {
      "description": "Pickup only: estimated arrival time chosen by the customer",
      "format": "date-time",
      "type": "string"
    },
    "placed_at": {
      "description": "When the order was placed",
      "format": "date-time",
      "type": "string"
    },
    "rejection_reason": {
      "description": "Reason if order was rejected/cancelled",
      "type": "string"
    },
    "rider_email": {
      "description": "Email of the assigned rider",
      "type": "string"
    },
    "rider_name": {
      "description": "Display name of the assigned rider",
      "type": "string"
    },
    "rider_phone": {
      "description": "Phone number of the assigned rider for customer call button",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "description": "Current order status",
      "enum": [
        "pending",
        "accepted",
        "preparing",
        "out_for_delivery",
        "ready_for_pickup",
        "delivered",
        "cancelled"
      ],
      "type": "string"
    },
    "subtotal": {
      "description": "Sum of item prices before discount, GST and delivery fee",
      "type": "number"
    },
    "total_amount": {
      "description": "Final total: subtotal - discount + GST + delivery fee",
      "type": "number"
    }
  },
  "required": [
    "order_number",
    "customer_email",
    "items",
    "total_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "data.rider_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "manager"
          }
        },
        {
          "data.rider_email": "{{user.email}}"
        }
      ]
    }
  },
  "type": "object"
}