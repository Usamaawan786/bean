{
  "name": "Chat Message Push Notification",
  "description": "Sends a Firebase push notification to the recipient whenever a new chat message is created \u2014 notifies the user when admin sends, and notifies admins when a user sends.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ChatMessage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "chat_message_push_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyChatMessage",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyChatMessage"
  }
}