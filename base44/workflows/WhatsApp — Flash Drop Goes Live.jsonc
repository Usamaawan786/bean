{
  "name": "WhatsApp \u2014 Flash Drop Goes Live",
  "description": "Fires when a FlashDrop status changes to active \u2014 broadcasts WhatsApp message to all users with a phone number.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"active\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "FlashDrop"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "whatsapp_flash_drop_goes_live",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "whatsAppFlashDropAlert",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "whatsAppFlashDropAlert"
  }
}