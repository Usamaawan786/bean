{
  "name": "Welcome Email #1 \u2014 Instant on Signup",
  "description": "Sends the first welcome email immediately when a new Customer record is created",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Customer"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "welcome_email_1_instant_on_signup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWelcomeEmailSeries",
            "args": {
              "email_number": 1
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendWelcomeEmailSeries"
  }
}